      "statement": "Interviewers should capture explicit uncertainty and follow-up probes for technical-to-business translation.",
      "allowed_use": "structured note template improvement",
      "blocked_use": "candidate-level risk label",
      "evidence_refs": [
        "MEM-INT-008-OBS-01",
