  "projection_hypotheses": [
    {
      "hypothesis_id": "PROJ-001",
      "statement": "Rubric dimension collaboration_maturity needs stronger calibration anchors before the next cycle.",
      "allowed_use": "faculty preparation and calibration workshop design",
      "blocked_use": "candidate scoring, ranking, or admit/reject decision",
      "evidence_refs": [
        "MEM-INT-003-OBS-02",
        "MEM-INT-010-OBS-01"
      ],
      "assumptions": "Synthetic interview notes reflect recurring disagreement patterns.",
      "confidence_label": "medium",
      "falsifiers": "If calibrated mock interviews produce consistent collaboration evidence without new anchors, revise or retire the hypothesis.",
      "reviewer": "faculty_panel_mock",
      "decision": "approved_for_mock_playbook",
      "outcome_check_date": "2026-08-31",
      "result": "pending"
    },
    {
      "hypothesis_id": "PROJ-002",
      "statement": "Questions about builder mindset should require concrete tradeoff evidence, not general ambition.",
      "allowed_use": "question-bank revision",
      "blocked_use": "candidate ranking or predictive success claim",
      "evidence_refs": [
        "MEM-INT-002-OBS-01",
        "MEM-INT-007-OBS-01"
      ],
      "assumptions": "The question bank currently rewards broad systems language unless probes force specificity.",
      "confidence_label": "medium",
      "falsifiers": "If next-cycle responses show high concrete evidence density without probes, the hypothesis weakens.",
      "reviewer": "faculty_chair_mock",
      "decision": "approved_for_mock_playbook",
      "outcome_check_date": "2026-08-31",
      "result": "pending"
    },
    {
